{
  "name": "static-html-host",
  "version": "1.0.0",
  "description": "Local static HTML hosting system with HTML/ZIP upload and SQLite metadata.",
  "main": "src/server.js",
  "bin": "server-entry.js",
  "scripts": {
    "start": "node src/server.js",
    "build:win": "node scripts/build-win.js",
    "build:python-launcher": "powershell -ExecutionPolicy Bypass -File scripts/build-python-launcher.ps1"
  },
  "pkg": {
    "assets": [
      "node_modules/better-sqlite3/build/Release/**/*.node"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^11.9.1",
    "express": "^4.21.2",
    "mime-types": "^2.1.35",
    "multer": "^2.1.1",
    "yauzl": "^3.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
